{
	"name": "@corensystem/coren-docs",
	"version": "1.3.0",
	"description": "Component documentation and examples for the Coren Design System",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/examples/badge/index.mjs",
	"types": "./dist/examples/badge/index.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		"./index.json": "./dist/index.json",
		"./docs/*": "./dist/docs/*",
		"./examples/badge": {
			"types": "./dist/examples/badge/index.d.mts",
			"import": "./dist/examples/badge/index.mjs"
		},
		"./examples/button": {
			"types": "./dist/examples/button/index.d.mts",
			"import": "./dist/examples/button/index.mjs"
		},
		"./examples/checkbox": {
			"types": "./dist/examples/checkbox/index.d.mts",
			"import": "./dist/examples/checkbox/index.mjs"
		},
		"./examples/input": {
			"types": "./dist/examples/input/index.d.mts",
			"import": "./dist/examples/input/index.mjs"
		},
		"./examples/label": {
			"types": "./dist/examples/label/index.d.mts",
			"import": "./dist/examples/label/index.mjs"
		},
		"./examples/radio-group": {
			"types": "./dist/examples/radio-group/index.d.mts",
			"import": "./dist/examples/radio-group/index.mjs"
		},
		"./examples/select": {
			"types": "./dist/examples/select/index.d.mts",
			"import": "./dist/examples/select/index.mjs"
		},
		"./examples/switch": {
			"types": "./dist/examples/switch/index.d.mts",
			"import": "./dist/examples/switch/index.mjs"
		},
		"./examples/textarea": {
			"types": "./dist/examples/textarea/index.d.mts",
			"import": "./dist/examples/textarea/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && node scripts/build-docs.mjs",
		"build:examples": "tsdown",
		"build:docs": "node scripts/build-docs.mjs",
		"docs:check": "node scripts/check-docs.mjs",
		"typecheck": "tsgo --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check ."
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"@corensystem/coren-ui": "^1.0.0",
		"lucide-react": ">=0.400.0"
	},
	"devDependencies": {
		"@corensystem/coren-ui": "workspace:*",
		"@types/react": "^19.0.0",
		"lucide-react": "^0.511.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsdown": "latest",
		"typescript": "^5.9.0"
	}
}
