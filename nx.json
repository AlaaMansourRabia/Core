{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultBase": "main",
	"namedInputs": {
		"default": ["{projectRoot}/**/*"],
		"production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.test.ts"]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"],
			"cache": true,
			"outputs": ["{projectRoot}/dist"]
		},
		"dev": {
			"cache": false
		},
		"lint": {
			"cache": true
		},
		"typecheck": {
			"cache": true
		},
		"test": {
			"dependsOn": ["^build"],
			"cache": true
		},
		"format": {
			"cache": false
		},
		"format:check": {
			"cache": true
		}
	}
}
