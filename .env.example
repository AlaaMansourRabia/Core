# GitHub-only sign-in (wakecap org) — see docs/GITHUB-AUTH.md
# Set these in Vercel (Project → Settings → Environment Variables) for production.

# From your GitHub OAuth App (register under the wakecap org)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to sign the session JWT (jose HS256). Generate: openssl rand -hex 32
AUTH_SECRET=
