diff --git a/apps/web/src/components/WakeCorePanel.tsx b/apps/web/src/components/WakeCorePanel.tsx
new file mode 100644
index 0000000..cbba19f
--- /dev/null
+++ b/apps/web/src/components/WakeCorePanel.tsx
@@ -0,0 +1,146 @@
+// WakeCore Studio info panel — explains the generated screen from the run's `wakecore.json` sidecar
+// (written by the wakecore-compose skill): template + rationale, widgets, validation, decision trace,
+// and links back to the Designer Hub + Storybook. Fixed right-docked + toggleable so it never disturbs
+// Open Design's split layout. Re-fetches whenever a run completes.
+import {useEffect, useState} from 'react';
+import {fetchProjectFileText} from '../providers/registry';
+import {RUNS_CHANGED_EVENT} from '../providers/daemon';
+
+interface WakeCoreDecision {
+  template?: {id?: string; name?: string; rationale?: string};
+  widgets?: Array<{widget: string; region: string}>;
+  validation?: {
+    buildable?: boolean;
+    summary?: {errors?: number; warnings?: number};
+    issues?: Array<{level?: string; message?: string; fix?: string}>;
+  };
+  trace?: Array<{tool: string; summary: string}>;
+}
+
+// Local Designer Hub / Storybook dev ports.
+const HUB = 'http://localhost:5174';
+const STORYBOOK = 'http://localhost:6006';
+
+function kebab(s: string): string {
+  return s
+    .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1-$2')
+    .toLowerCase();
+}
+
+export function WakeCorePanel({projectId}: {projectId: string}) {
+  const [data, setData] = useState<WakeCoreDecision | null>(null);
+  const [open, setOpen] = useState(true);
+
+  useEffect(() => {
+    let alive = true;
+    const load = async () => {
+      const text = await fetchProjectFileText(projectId, 'wakecore.json', {cache: 'no-store', cacheBustKey: Date.now()});
+      if (!alive) return;
+      try {
+        setData(text ? (JSON.parse(text) as WakeCoreDecision) : null);
+      } catch {
+        setData(null);
+      }
+    };
+    void load();
+    const onRuns = () => void load();
+    window.addEventListener(RUNS_CHANGED_EVENT, onRuns);
+    return () => {
+      alive = false;
+      window.removeEventListener(RUNS_CHANGED_EVENT, onRuns);
+    };
+  }, [projectId]);
+
+  if (!open) {
+    return (
+      <button className="wakecore-panel-toggle" onClick={() => setOpen(true)} title="Show what WakeCore built">
+        WakeCore
+      </button>
+    );
+  }
+
+  const t = data?.template;
+  const widgets = data?.widgets ?? [];
+  const v = data?.validation;
+  const trace = data?.trace ?? [];
+
+  return (
+    <aside className="wakecore-panel" aria-label="What WakeCore built">
+      <div className="wakecore-panel__head">
+        <span>What WakeCore built</span>
+        <button onClick={() => setOpen(false)} aria-label="Hide panel">
+          ×
+        </button>
+      </div>
+
+      {!data ? (
+        <div className="wakecore-panel__muted">No WakeCore decision yet — generate a screen and this panel explains it.</div>
+      ) : (
+        <>
+          {t && (
+            <section>
+              <h4>Template</h4>
+              <div className="wakecore-panel__name">{t.name}</div>
+              {t.id && <code className="wakecore-panel__code">{t.id}</code>}
+              {t.rationale && <p className="wakecore-panel__muted">{t.rationale}</p>}
+              <div className="wakecore-panel__links">
+                <a href={`${HUB}/components/${kebab(t.name ?? t.id ?? '')}`} target="_blank" rel="noreferrer">
+                  Designer Hub
+                </a>
+                <a href={STORYBOOK} target="_blank" rel="noreferrer">
+                  Storybook
+                </a>
+              </div>
+            </section>
+          )}
+
+          <section>
+            <h4>Widgets ({widgets.length})</h4>
+            {widgets.length === 0 ? (
+              <div className="wakecore-panel__muted">None placed.</div>
+            ) : (
+              widgets.map((w, i) => (
+                <div className="wakecore-panel__row" key={`${w.widget}-${i}`}>
+                  <span className="wakecore-panel__name">{w.widget}</span>
+                  <span className="wakecore-panel__muted">{w.region}</span>
+                  <a href={`${HUB}/components/${kebab(w.widget)}`} target="_blank" rel="noreferrer" title="Designer Hub">
+                    ↗
+                  </a>
+                </div>
+              ))
+            )}
+          </section>
+
+          {v && (
+            <section>
+              <h4>Validation</h4>
+              <div className={v.buildable ? 'wakecore-ok' : 'wakecore-bad'}>
+                {v.buildable ? 'Buildable' : 'Not buildable yet'} · {v.summary?.errors ?? 0} errors · {v.summary?.warnings ?? 0} warnings
+              </div>
+              {(v.issues ?? []).map((iss, i) => (
+                <div className="wakecore-panel__issue" key={i}>
+                  {iss.level === 'error' ? '✗' : '⚠'} {iss.message}
+                  {iss.fix ? <span className="wakecore-panel__muted"> — {iss.fix}</span> : null}
+                </div>
+              ))}
+            </section>
+          )}
+
+          {trace.length > 0 && (
+            <section>
+              <h4>How WakeCore decided</h4>
+              <ol className="wakecore-panel__trace">
+                {trace.map((s, i) => (
+                  <li key={i}>
+                    <code>{s.tool}</code> — {s.summary}
+                  </li>
+                ))}
+              </ol>
+            </section>
+          )}
+        </>
+      )}
+    </aside>
+  );
+}
