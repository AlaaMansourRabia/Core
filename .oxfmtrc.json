{
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": false,
	"bracketSpacing": false,
	"semi": true,
	"trailingComma": "all",
	"endOfLine": "lf",
	"sortImports": {
		"groups": [
			"type-import",
			["value-builtin", "value-external"],
			["value-internal", "type-internal"],
			["value-parent", "value-sibling", "value-index", "type-parent", "type-sibling", "type-index"],
			"unknown"
		]
	}
}
