{
	"name": "@corensystem/coren-docs",
	"version": "1.0.1",
	"description": "Component documentation and examples for the Coren Design System",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/examples/badge.mjs",
	"types": "./dist/examples/badge.d.mts",
	"files": [
		"dist"
	],
	"exports": {
		"./index.json": "./dist/index.json",
		"./docs/*": "./dist/docs/*",
		"./examples/badge": {
			"types": "./dist/examples/badge.d.mts",
			"import": "./dist/examples/badge.mjs"
		},
		"./examples/label": {
			"types": "./dist/examples/label.d.mts",
			"import": "./dist/examples/label.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && node scripts/build-docs.mjs",
		"build:examples": "tsdown",
		"build:docs": "node scripts/build-docs.mjs",
		"typecheck": "tsgo --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check ."
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"@corensystem/coren-ui": "^1.0.0",
		"lucide-react": "^0.400.0"
	},
	"devDependencies": {
		"@corensystem/coren-ui": "workspace:*",
		"@types/react": "^19.0.0",
		"lucide-react": "^0.511.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsdown": "latest",
		"typescript": "^5.9.0"
	}
}
