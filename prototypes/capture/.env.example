# Copy to .env.local and fill in. .env.local is gitignored.
LOCAL_GLB_PATH=
# Cesium ion token — https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=
# Stadia Maps API key (Stamen Toner imagery, required in production)
VITE_STADIA_API_KEY=
# Pre-converted building model served as a static asset
VITE_BUILDING_GLB=/models/building.glb
