{
	"name": "@corensystem/coren-tokens",
	"version": "1.0.2",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"style": "./dist/index.css",
			"import": "./dist/index.css"
		},
		"./css": {
			"style": "./dist/index.css",
			"import": "./dist/index.css"
		},
		"./theme": {
			"style": "./dist/theme.css",
			"import": "./dist/theme.css"
		},
		"./fonts": {
			"style": "./dist/fonts.css",
			"import": "./dist/fonts.css"
		},
		"./fonts/*": "./dist/fonts/*",
		"./tailwind3-preset": "./dist/tailwind3-preset.cjs"
	},
	"files": [
		"dist",
		"skills",
		"!skills/_artifacts",
		"bin"
	],
	"scripts": {
		"build": "mkdir -p dist && cp src/index.css dist/index.css && cp src/theme.css dist/theme.css && cp src/fonts.css dist/fonts.css && cp -R src/fonts dist/fonts && cp src/tailwind3-preset.cjs dist/tailwind3-preset.cjs"
	},
	"bin": {
		"intent": "./bin/intent.js"
	}
}
