{
	"name": "@corensystem/coren-utils",
	"version": "1.0.1",
	"bin": {
		"intent": "./bin/intent.js"
	},
	"files": [
		"dist",
		"skills",
		"!skills/_artifacts",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc src/index.ts --outDir dist --module ESNext --moduleResolution bundler --declaration --target ES2022 && mv dist/index.js dist/index.mjs && mv dist/index.d.ts dist/index.d.mts",
		"typecheck": "tsgo --noEmit",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"format:check": "oxfmt --check ."
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"tsdown": "latest"
	}
}
