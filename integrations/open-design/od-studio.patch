+/* WakeCore Studio info panel */
+.wakecore-panel {
+  position: fixed;
+  top: 46px;
+  right: 0;
+  bottom: 0;
+  width: 320px;
+  z-index: 40;
+  border-left: 1px solid var(--border, #e5e7eb);
+  background: var(--bg-panel, #fff);
+  color: var(--text, #0f172a);
+  overflow-y: auto;
+  padding: 14px 16px;
+  font-size: 13px;
+  line-height: 1.5;
+}
+.wakecore-panel__head { display: flex; justify-content: space-between; align-items: center; font-weight: 600; margin-bottom: 6px; }
+.wakecore-panel__head button { border: 0; background: none; cursor: pointer; font-size: 18px; line-height: 1; color: var(--text-muted, #64748b); }
+.wakecore-panel section { border-top: 1px solid var(--border, #eee); padding: 10px 0; }
+.wakecore-panel h4 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted, #64748b); margin: 0 0 6px; }
+.wakecore-panel__name { font-weight: 600; }
+.wakecore-panel__code { font-size: 11px; color: var(--text-muted, #64748b); }
+.wakecore-panel__muted { color: var(--text-muted, #64748b); }
+.wakecore-panel__links { display: flex; gap: 12px; align-items: center; margin-top: 6px; }
+.wakecore-panel__row { display: flex; gap: 10px; align-items: center; justify-content: space-between; padding: 3px 0; }
+.wakecore-panel__links a, .wakecore-panel__row a { color: var(--accent, #d65a31); text-decoration: none; font-size: 12px; }
+.wakecore-panel__links a:hover, .wakecore-panel__row a:hover { text-decoration: underline; }
+.wakecore-panel__issue { font-size: 12px; padding: 2px 0; }
+.wakecore-ok { color: #16a34a; }
+.wakecore-bad { color: #dc2626; }
+.wakecore-panel__trace { margin: 0; padding-left: 16px; font-size: 12px; }
+.wakecore-panel__trace code, .wakecore-panel__code { color: var(--accent, #d65a31); }
+.wakecore-panel-toggle {
+  position: fixed;
+  top: 54px;
+  right: 12px;
+  z-index: 40;
+  border: 1px solid var(--border, #e5e7eb);
+  background: var(--bg-panel, #fff);
+  color: var(--text, #0f172a);
+  border-radius: 999px;
+  padding: 4px 12px;
+  font-size: 12px;
+  cursor: pointer;
+}
